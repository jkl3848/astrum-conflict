{
  "name": "@astrum/game",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./content/*": "./content/*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "content:check": "tsx src/scripts/content-check.ts",
    "content:diff": "tsx src/scripts/content-diff.ts",
    "content:release": "tsx src/scripts/content-release.ts",
    "content:regen-rules": "python scripts/extract_rules_to_md.py && python scripts/generate_rules_content.py"
  },
  "dependencies": {
    "yaml": "^2.7.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
