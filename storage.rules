rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Art is private: only signed-in clients with App Check may read.
    // Prefer getBlob() via the Storage SDK (not public download URLs).
    match /art/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
